        <div id="root"></div>
        <div id="loadingPage" class="loader-page">
            <div>
                <div class="loader"></div>
                <p id="loadingText">Loading</p>
            </div>
        </div>
        <script>
            const urlParams = new URLSearchParams(window.location.search)
            if (urlParams.has("route")) {
                document.querySelector(".loader-page")?.classList.add("show")
            }
            ;(function () {
                var loadingStrings = {
                    en: "Loading",
                    es: "Cargando",
                    vi: "Đang tải",
                }
                var lang = "en"
                var fromQuery = urlParams.get("lang")
                var stored = null
                try {
                    stored = localStorage.getItem("511x:language")
                } catch (e) {}
                if (stored) {
                    stored = stored.replace(/^"|"$/g, "")
                }
                if (fromQuery && loadingStrings[fromQuery]) {
                    lang = fromQuery
                } else if (stored && loadingStrings[stored]) {
                    lang = stored
                }
                var loadingTextEl = document.getElementById("loadingText")
                if (loadingTextEl) {
                    loadingTextEl.textContent = loadingStrings[lang]
                }
            })()
        </script>
