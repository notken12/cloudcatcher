# Copy to camera/.env (git-ignored); loaded automatically by `uv run sunroof-camera ...`.
# All camera sources except Windy/NSW are keyless.

# Windy Webcams API v3 (global filler source) - https://api.windy.com/keys
WINDY_API_KEY=

# VLM frame-validation gate; if empty, the VLM step is skipped (or set SUNROOF_VLM_BASE_URL for Ollama/vLLM)
OPENAI_API_KEY=

# Transport for NSW Open Data (Live Traffic Cameras) - https://opendata.transport.nsw.gov.au
NSW_API_KEY=

# Optional: NY 511 official API (the open list endpoint works without it)
NY511_API_KEY=
